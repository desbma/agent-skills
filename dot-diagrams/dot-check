#!/usr/bin/env python3
"""Check the layout of a Graphviz diagram for defects and crossings."""

import argparse
import itertools
import json
import math
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Any

type Point = tuple[float, float]
type Segment = tuple[Point, Point]
type Polyline = list[Point]
# Left, bottom, right, top
type Rect = tuple[float, float, float, float]

# Largest gap between an arrow end and its node's outline still drawn as touching, in points
ATTACH_TOLERANCE = 1.5
# Distance from an arrow end within which another arrow meets it rather than crosses it, in points
END_TOLERANCE = 2.0
# Smallest angle between an arrowhead and the outline it touches, in degrees
MIN_ARROWHEAD_ANGLE = 30.0
# Smallest gap between two arrowheads, in points
ARROWHEAD_GAP = 2.0
# Smallest gap between a box and a frame line, in points
FRAME_GAP = 4.0
# Corner radius of rounded boxes, capped at a third of their shorter side, in points
CORNER_RADIUS = 12.0
# Node shapes drawn as rectangles
BOXES = {"box", "rect", "rectangle", "square"}
# Clearance around a text line, in points
LABEL_MARGIN = 1.0
# Text extent below and above its baseline, as fractions of the font size
TEXT_DESCENT = 0.2
TEXT_ASCENT = 0.7
# Points sampled per Bézier segment and per ellipse
BEZIER_STEPS = 16
ELLIPSE_STEPS = 64


@dataclass
class Report:
    """Layout problems and size of a rendered diagram."""

    defects: list[str]
    crossings: list[str]
    size: tuple[float, float]


@dataclass
class Shape:
    """Drawn element, as the lines tracing it."""

    name: str
    lines: list[Polyline]
    # Whether the outline is a box with rounded corners
    rounded_box: bool = False
    # Nodes a frame encloses
    members: frozenset[int] = frozenset()


@dataclass
class End:
    """Tail or head of a drawn arrow."""

    # Shape the end attaches to, the node or the frame given by ltail or lhead
    outline: Shape | None
    # Point that must touch the outline: the arrowhead tip, or the line end
    point: Point
    # Point the arrowhead points from, where it meets the line
    base: Point
    arrowhead: list[Polyline]


@dataclass
class Edge:
    """Drawn arrow."""

    name: str
    tail: int
    head: int
    lines: list[Polyline]
    # Path all colors of the arrow are drawn along, a line per spline
    centerline: list[Polyline]
    # Tail and head, by name
    ends: dict[str, End]

    def drawn(self) -> list[Polyline]:
        """Return the lines of the arrow and of its arrowheads."""
        return self.lines + [
            line for end in self.ends.values() for line in end.arrowhead
        ]


@dataclass
class Label:
    """Drawn text line."""

    name: str
    rect: Rect
    # Node drawn as this text alone, whose arrows end against it
    node: int | None = None


def bezier(points: list[Point]) -> Polyline:
    """Sample a piecewise cubic Bézier curve given by its control points."""
    sampled = [points[0]]
    for i in range(0, len(points) - 3, 3):
        xs, ys = zip(*points[i : i + 4])
        for step in range(1, BEZIER_STEPS + 1):
            t = step / BEZIER_STEPS
            weights = ((1 - t) ** 3, 3 * (1 - t) ** 2 * t, 3 * (1 - t) * t**2, t**3)
            sampled.append((math.sumprod(weights, xs), math.sumprod(weights, ys)))
    return sampled


def trace(ops: list[dict[str, Any]]) -> list[Polyline]:
    """Return the lines drawn by xdot operations, closed shapes closed."""
    lines = []
    for op in ops:
        match op["op"]:
            case "p" | "P":
                points = [(x, y) for x, y in op["points"]]
                lines.append(points + points[:1])
            case "L":
                lines.append([(x, y) for x, y in op["points"]])
            case "b" | "B":
                lines.append(bezier([(x, y) for x, y in op["points"]]))
            case "e" | "E":
                x, y, rx, ry = op["rect"]
                points = [
                    (
                        x + rx * math.cos(2 * math.pi * i / ELLIPSE_STEPS),
                        y + ry * math.sin(2 * math.pi * i / ELLIPSE_STEPS),
                    )
                    for i in range(ELLIPSE_STEPS)
                ]
                lines.append(points + points[:1])
    return lines


def texts(ops: list[dict[str, Any]]) -> list[tuple[str, Rect]]:
    """Return the text lines drawn by xdot operations, with their extent."""
    result: list[tuple[str, Rect]] = []
    size = 0.0
    color = ""
    for op in ops:
        if op["op"] == "F":
            size = op["size"]
        elif op["op"] == "c":
            color = op["color"]
        elif op["op"] == "T" and not transparent(color):
            (x, y), width = op["pt"], op["width"]
            left = {"l": x, "c": x - width / 2, "r": x - width}[op["align"]]
            text = op["text"]
            rect = (left, y - TEXT_DESCENT * size, left + width, y + TEXT_ASCENT * size)
            # Differently formatted runs of a line are drawn one after the other
            if result and overlap(result[-1][1], rect):
                previous, extent = result.pop()
                text = previous + text
                rect = (
                    min(extent[0], rect[0]),
                    min(extent[1], rect[1]),
                    max(extent[2], rect[2]),
                    max(extent[3], rect[3]),
                )
            result.append((text, rect))
    return result


def transparent(color: str) -> bool:
    """Tell whether a color is fully transparent."""
    return color == "transparent" or (len(color) == 9 and color.endswith("00"))


def visible(ops: list[dict[str, Any]]) -> list[dict[str, Any]]:
    """Return xdot operations, or none when all their colors are fully transparent."""
    colors = [
        stop["color"]
        for op in ops
        if op["op"] in "cC"
        for stop in (op["stops"] if op["grad"] != "none" else [op])
    ]
    return [] if colors and all(map(transparent, colors)) else ops


def segments(lines: list[Polyline]) -> list[Segment]:
    """Return the segments of polylines."""
    return [segment for line in lines for segment in itertools.pairwise(line)]


def intersection(s: Segment, t: Segment) -> Point | None:
    """Return the point where two segments cross, if they do."""
    (px, py), (px2, py2) = s
    (qx, qy), (qx2, qy2) = t
    dx, dy = px2 - px, py2 - py
    ex, ey = qx2 - qx, qy2 - qy
    denominator = dx * ey - dy * ex
    if denominator == 0:
        return None
    a = ((qx - px) * ey - (qy - py) * ex) / denominator
    b = ((qx - px) * dy - (qy - py) * dx) / denominator
    if 0 <= a <= 1 and 0 <= b <= 1:
        return (px + a * dx, py + a * dy)
    return None


def crossings(a: list[Polyline], b: list[Polyline]) -> list[Point]:
    """Return the points where two sets of polylines cross."""
    return [
        point
        for s, t in itertools.product(segments(a), segments(b))
        if (point := intersection(s, t)) is not None
    ]


def point_distance(point: Point, segment: Segment) -> float:
    """Return the distance from a point to a segment."""
    (ax, ay), (bx, by) = segment
    dx, dy = bx - ax, by - ay
    length = dx * dx + dy * dy
    t = 0 if length == 0 else ((point[0] - ax) * dx + (point[1] - ay) * dy) / length
    t = min(max(t, 0), 1)
    return math.dist(point, (ax + t * dx, ay + t * dy))


def gap(a: list[Polyline], b: list[Polyline]) -> float:
    """Return the distance between two sets of polylines."""
    if crossings(a, b):
        return 0.0
    return min(
        point_distance(point, segment)
        for lines, others in ((a, b), (b, a))
        for line in lines
        for point in line
        for segment in segments(others)
    )


def inside(point: Point, lines: list[Polyline]) -> bool:
    """Tell whether a point lies inside one of closed polylines."""
    x, y = point
    for line in lines:
        if line[0] != line[-1]:
            continue
        crossed = False
        for (ax, ay), (bx, by) in itertools.pairwise(line):
            if (ay > y) != (by > y) and x < ax + (y - ay) * (bx - ax) / (by - ay):
                crossed = not crossed
        if crossed:
            return True
    return False


def at_rounded_corner(point: Point, lines: list[Polyline]) -> bool:
    """Tell whether a point lies in the square at a corner of a rounded box where the rounding is drawn."""
    xs, ys = zip(*(p for line in lines for p in line))
    radius = min(CORNER_RADIUS, (max(xs) - min(xs)) / 3, (max(ys) - min(ys)) / 3)
    # Distances to the nearest vertical and horizontal sides, negative outside
    return all(
        -ATTACH_TOLERANCE < min(v - min(vs), max(vs) - v) < radius
        for v, vs in ((point[0], xs), (point[1], ys))
    )


def center(rect: Rect) -> Point:
    """Return the center of a rectangle."""
    return (rect[0] + rect[2]) / 2, (rect[1] + rect[3]) / 2


def touches(rect: Rect, lines: list[Polyline]) -> bool:
    """Tell whether polylines enter a rectangle widened by the label margin."""
    left, bottom, right, top = (
        rect[0] - LABEL_MARGIN,
        rect[1] - LABEL_MARGIN,
        rect[2] + LABEL_MARGIN,
        rect[3] + LABEL_MARGIN,
    )
    if any(
        left <= x <= right and bottom <= y <= top for line in lines for x, y in line
    ):
        return True
    corners = [(left, bottom), (right, bottom), (right, top), (left, top)]
    return bool(crossings(lines, [corners + corners[:1]]))


def overlap(a: Rect, b: Rect) -> bool:
    """Tell whether two rectangles come closer than the label margin."""
    return (
        a[0] - LABEL_MARGIN < b[2]
        and b[0] - LABEL_MARGIN < a[2]
        and a[1] - LABEL_MARGIN < b[3]
        and b[1] - LABEL_MARGIN < a[3]
    )


def render(path: Path) -> dict[str, Any]:
    """Lay out a .dot file and return Graphviz's JSON description of the drawing."""
    result = subprocess.run(
        ["dot", "-Tjson", str(path)],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=None,
        check=True,
        text=True,
    )
    return json.loads(result.stdout)


def check(graph: dict[str, Any]) -> Report:
    """Find layout defects and arrow crossings in a laid out graph."""
    objects = graph.get("objects", [])
    nodes = {}
    frames = {}
    labels = []
    for i, o in enumerate(objects):
        if "nodes" not in o:
            lines = trace(visible(o.get("_draw_", [])) + o.get("_ldraw_", []))
            # Nodes drawing no line, like invisible ones or bare text, have none to attach to
            if lines:
                styles = o.get("style", "").replace(",", " ").split()
                rounded_box = o.get("shape") in BOXES and "rounded" in styles
                nodes[i] = Shape(o["name"], lines, rounded_box)
            # Text within its node's outline is checked with the outline
            labels.extend(
                Label(f'label "{text}" of {o["name"]}', rect, None if lines else i)
                for text, rect in texts(o.get("_ldraw_", []))
                if not lines or not inside(center(rect), lines)
            )
        else:
            # Frames drawing no line, like transparent ones, have none to check
            if lines := trace(visible(o.get("_draw_", []))):
                name = (
                    f'frame "{o["label"]}"' if o.get("label") else f"frame {o['name']}"
                )
                frames[o["name"]] = Shape(name, lines, members=frozenset(o["nodes"]))
            labels.extend(
                Label(f'title "{text}"', rect)
                for text, rect in texts(o.get("_ldraw_", []))
            )
    arrow = "->" if graph["directed"] else "--"
    edges = []
    for e in sorted(graph.get("edges", []), key=lambda e: e["_gvid"]):
        name = f"{objects[e['tail']]['name']} {arrow} {objects[e['head']]['name']}"
        for key in ("_ldraw_", "_hldraw_", "_tldraw_"):
            labels.extend(
                Label(f'label "{text}" of {name}', rect)
                for text, rect in texts(e.get(key, []))
            )
        lines = trace([op for op in visible(e.get("_draw_", [])) if op["op"] in "bB"])
        if not lines:
            continue
        # The edge's splines: their arrowhead tips, s at the tail and e at the head, then their points
        splines = [[t.split(",") for t in part.split()] for part in e["pos"].split(";")]
        tips = {
            t[0]: (float(t[1]), float(t[2])) for s in splines for t in s if len(t) == 3
        }
        paths = [
            [(float(t[0]), float(t[1])) for t in s if len(t) == 2] for s in splines
        ]
        edges.append(
            Edge(
                name=name,
                tail=e["tail"],
                head=e["head"],
                lines=lines,
                centerline=[bezier(path) for path in paths],
                ends={
                    "tail": End(
                        frames.get(e.get("ltail")) or nodes.get(e["tail"]),
                        tips.get("s", paths[0][0]),
                        paths[0][0],
                        trace(visible(e.get("_tdraw_", []))),
                    ),
                    "head": End(
                        frames.get(e.get("lhead")) or nodes.get(e["head"]),
                        tips.get("e", paths[-1][-1]),
                        paths[-1][-1],
                        trace(visible(e.get("_hdraw_", []))),
                    ),
                },
            )
        )

    defects = []
    for edge in edges:
        for kind, end in edge.ends.items():
            if not (outline := end.outline):
                continue
            sides = segments(outline.lines)
            off = min(point_distance(end.point, s) for s in sides)
            if off > ATTACH_TOLERANCE:
                corner = outline.rounded_box and at_rounded_corner(
                    end.point, outline.lines
                )
                defects.append(
                    f"{edge.name}: {kind} {off:.1f}pt off the outline of {outline.name}"
                    + ", at a rounded corner" * corner
                )
            elif end.arrowhead and end.point != end.base:
                # The base's distance to the outline over the arrowhead's length is the sine
                # of the angle against a straight side, and follows the outline past the tip
                clearance = min(point_distance(end.base, s) for s in sides)
                length = math.dist(end.base, end.point)
                meeting_angle = math.degrees(math.asin(min(1, clearance / length)))
                if meeting_angle < MIN_ARROWHEAD_ANGLE:
                    defects.append(
                        f"{edge.name}: {kind} meets the outline of {outline.name} at {meeting_angle:.0f}°"
                    )
        for i, node in nodes.items():
            if i not in (edge.tail, edge.head) and crossings(edge.drawn(), node.lines):
                defects.append(f"{edge.name}: passes through {node.name}")
        ends = [end.point for end in edge.ends.values()]
        for frame in frames.values():
            # Points where the arrow crosses the outline away from its ends, once each
            points: list[Point] = []
            for point in crossings(edge.centerline, frame.lines):
                if min(math.dist(point, p) for p in ends + points) > END_TOLERANCE:
                    points.append(point)
            inside_ends = sum(i in frame.members for i in (edge.tail, edge.head))
            # An arrow with one end inside crosses the outline once, others never
            if len(points) > int(inside_ends == 1):
                way = "leaves and re-enters" if inside_ends else "passes through"
                defects.append(f"{edge.name}: {way} {frame.name}")
    for node in nodes.values():
        for frame in frames.values():
            if gap(node.lines, frame.lines) < FRAME_GAP:
                defects.append(f"{node.name}: touches {frame.name}")
    # Drawn arrowheads, with the arrow and the end they belong to
    arrowheads = [
        (edge, kind, end.arrowhead)
        for edge in edges
        for kind, end in edge.ends.items()
        if end.arrowhead
    ]
    pairs = itertools.combinations(arrowheads, 2)
    for (a, a_kind, a_lines), (b, b_kind, b_lines) in pairs:
        if gap(a_lines, b_lines) < ARROWHEAD_GAP:
            defects.append(f"{a.name}: {a_kind} overlaps the {b_kind} of {b.name}")
    for i, label in enumerate(labels):
        for edge in edges:
            if label.node not in (edge.tail, edge.head) and touches(
                label.rect, edge.drawn()
            ):
                defects.append(f"{label.name}: touches {edge.name}")
        for node in nodes.values():
            if touches(label.rect, node.lines) or inside(
                center(label.rect), node.lines
            ):
                defects.append(f"{label.name}: touches {node.name}")
        for other in labels[i + 1 :]:
            if overlap(label.rect, other.rect):
                defects.append(f"{label.name}: touches {other.name}")
        for frame in frames.values():
            if touches(label.rect, frame.lines):
                defects.append(f"{label.name}: touches {frame.name}")

    crossed = []
    for a, b in itertools.combinations(edges, 2):
        ends = [end.point for edge in (a, b) for end in edge.ends.values()]
        if any(
            min(math.dist(point, end) for end in ends) > END_TOLERANCE
            for point in crossings(a.lines, b.lines)
        ):
            crossed.append(f"{a.name} crosses {b.name}")

    left, bottom, right, top = map(float, graph["bb"].split(","))
    return Report(defects, crossed, (right - left, top - bottom))


def main() -> None:
    """Check the .dot file given on the command line, print the problems and size, and fail on defects."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("file", type=Path, help="Graphviz .dot file")
    args = parser.parse_args()
    report = check(render(args.file))
    for defect in report.defects:
        print(f"Defect: {defect}")
    for crossing in report.crossings:
        print(f"Crossing: {crossing}")
    defects, crossed = len(report.defects), len(report.crossings)
    print(
        f"Size: {report.size[0]:g} × {report.size[1]:g}pt, "
        f"{defects} defect{'s' * (defects != 1)}, {crossed} crossing{'s' * (crossed != 1)}"
    )
    if report.defects:
        sys.exit(1)


if __name__ == "__main__":
    main()
