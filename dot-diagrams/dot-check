#!/usr/bin/env python3
"""Check the layout of a Graphviz diagram for defects and crossings."""

import argparse
import itertools
import json
import math
import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Any

type Point = tuple[float, float]
type Segment = tuple[Point, Point]
type Polyline = list[Point]
# Left, bottom, right, top
type Rect = tuple[float, float, float, float]
# Layout problem, and where it is drawn
type Finding = tuple[str, Point]

# Largest gap between an arrow end and its attached outline still drawn as touching, in points
ATTACH_TOLERANCE = 1.0
# Distance from an arrow end within which another arrow meets it rather than crosses it, in points
END_TOLERANCE = 2.0
# Smallest angle between an arrowhead and the outline it touches, in degrees
MIN_ARROWHEAD_ANGLE = 40.0
# Smallest gap between two arrowheads, in points
ARROWHEAD_GAP = 2.0
# Smallest gap between a box or arrowhead and a frame line, in points
FRAME_GAP = 4.0
# Corner radius of rounded boxes, capped at a third of their shorter side, in points
CORNER_RADIUS = 12.0
# Node shapes drawn as rectangles
BOXES = {"box", "rect", "rectangle", "square"}
# Clearance around a text line, in points
LABEL_MARGIN = 1.0
# Text extent below and above its baseline, as fractions of the font size
TEXT_DESCENT = 0.2
TEXT_ASCENT = 0.7
# Points sampled per Bézier segment and per ellipse
BEZIER_STEPS = 16
ELLIPSE_STEPS = 64
# Style of an xdot operation setting the width of the lines drawn after it
LINE_WIDTH = re.compile(r"setlinewidth\((.*)\)")
# Size Graphviz's SVG output gives the drawing, in points
SVG_SIZE = re.compile(r'<svg width="(\S+)pt" height="(\S+)pt"')
# Transform of the group Graphviz's SVG output draws the graph in, from layout points with y negated
SVG_TRANSFORM = re.compile(
    r'<g id="[^"]*" class="graph[^"]*" transform="scale\((\S+) (\S+)\) rotate\((\S+)\) translate\((\S+) (\S+)\)"'
)
# Line of Graphviz's verbose output naming the font it measures a font name's text with, by its file when known
FONT_RESOLUTION = re.compile(
    r'fontname: (?:"(.*)" resolved to: (?:.*" )?(.+)|unable to resolve "(.*)")'
)
# Line of Graphviz's verbose output listing the installed layout engines
LAYOUTS = re.compile(r"^\s*layout\s*:\s*(.*)$", re.MULTILINE)


@dataclass
class Report:
    """Layout problems and size of a rendered diagram."""

    # Problems placed in points from the top left corner of the SVG, its margin included
    defects: list[Finding]
    crossings: list[Finding]
    # Size of the SVG, its margin included, in points
    size: tuple[float, float]


@dataclass
class Shape:
    """Drawn element, as the lines tracing it."""

    name: str
    lines: list[Polyline]
    # Drawn width of each line, in points
    line_widths: list[float]
    # Whether the outline is a box with rounded corners
    rounded_box: bool = False


@dataclass
class End:
    """Tail or head of a drawn arrow."""

    # Shape the end attaches to, its node or the frame it ends on
    outline: Shape | None
    # Point that must touch the outline: the arrowhead tip, or the line end
    point: Point
    # Point the arrowhead points from, where it meets the line
    base: Point
    arrowhead: list[Polyline]


@dataclass
class Edge:
    """Drawn arrow."""

    name: str
    tail: int
    head: int
    lines: list[Polyline]
    # Path all colors of the arrow are drawn along, a line per spline
    centerline: list[Polyline]
    # Tail and head, by name
    ends: dict[str, End]

    def drawn(self) -> list[Polyline]:
        """Return the lines of the arrow and of its arrowheads."""
        return self.lines + [
            line for end in self.ends.values() for line in end.arrowhead
        ]


@dataclass
class Label:
    """Drawn text line."""

    name: str
    rect: Rect
    # Node drawn as this text alone, whose arrows end against it
    node: int | None = None


def bezier(points: list[Point]) -> Polyline:
    """Sample a piecewise cubic Bézier curve given by its control points."""
    sampled = [points[0]]
    for i in range(0, len(points) - 3, 3):
        xs, ys = zip(*points[i : i + 4])
        for step in range(1, BEZIER_STEPS + 1):
            t = step / BEZIER_STEPS
            weights = ((1 - t) ** 3, 3 * (1 - t) ** 2 * t, 3 * (1 - t) * t**2, t**3)
            sampled.append((math.sumprod(weights, xs), math.sumprod(weights, ys)))
    return sampled


def trace(ops: list[dict[str, Any]]) -> list[Polyline]:
    """Return the lines drawn by xdot operations, closed shapes closed."""
    lines = []
    for op in ops:
        match op["op"]:
            case "p" | "P":
                points = [(x, y) for x, y in op["points"]]
                lines.append(points + points[:1])
            case "L":
                lines.append([(x, y) for x, y in op["points"]])
            case "b" | "B":
                lines.append(bezier([(x, y) for x, y in op["points"]]))
            case "e" | "E":
                x, y, rx, ry = op["rect"]
                points = [
                    (
                        x + rx * math.cos(2 * math.pi * i / ELLIPSE_STEPS),
                        y + ry * math.sin(2 * math.pi * i / ELLIPSE_STEPS),
                    )
                    for i in range(ELLIPSE_STEPS)
                ]
                lines.append(points + points[:1])
    return lines


def texts(ops: list[dict[str, Any]]) -> list[tuple[str, Rect]]:
    """Return the text lines drawn by xdot operations, with their extent."""
    result: list[tuple[str, Rect]] = []
    size = 0.0
    color = ""
    for op in ops:
        if op["op"] == "F":
            size = op["size"]
        elif op["op"] == "c":
            color = op["color"]
        elif op["op"] == "T" and not transparent(color):
            (x, y), width = op["pt"], op["width"]
            left = {"l": x, "c": x - width / 2, "r": x - width}[op["align"]]
            text = op["text"]
            rect = (left, y - TEXT_DESCENT * size, left + width, y + TEXT_ASCENT * size)
            # Differently formatted runs of a line are drawn one after the other
            if result and overlap(result[-1][1], rect):
                previous, extent = result.pop()
                text = previous + text
                rect = (
                    min(extent[0], rect[0]),
                    min(extent[1], rect[1]),
                    max(extent[2], rect[2]),
                    max(extent[3], rect[3]),
                )
            result.append((text, rect))
    return result


def line_widths(ops: list[dict[str, Any]]) -> list[float]:
    """Return the drawn width of each line traced from xdot operations, 0 for a transparent one."""
    widths = []
    width = 1.0
    color = ""
    for op in ops:
        if op["op"] == "S" and (match := LINE_WIDTH.fullmatch(op["style"])):
            width = float(match[1])
        elif op["op"] == "c":
            color = op["color"]
        elif op["op"] in "pPLbBeE":
            widths.append(0.0 if transparent(color) else width)
    return widths


def transparent(color: str) -> bool:
    """Tell whether a color is fully transparent."""
    return color == "transparent" or (len(color) == 9 and color.endswith("00"))


def visible(ops: list[dict[str, Any]]) -> list[dict[str, Any]]:
    """Return xdot operations, or none when all their colors are fully transparent."""
    colors = [
        stop["color"]
        for op in ops
        if op["op"] in "cC"
        for stop in (op["stops"] if op["grad"] != "none" else [op])
    ]
    return [] if colors and all(map(transparent, colors)) else ops


def segments(lines: list[Polyline]) -> list[Segment]:
    """Return the segments of polylines."""
    return [segment for line in lines for segment in itertools.pairwise(line)]


def intersection(s: Segment, t: Segment) -> Point | None:
    """Return the point where two segments cross, if they do."""
    (px, py), (px2, py2) = s
    (qx, qy), (qx2, qy2) = t
    dx, dy = px2 - px, py2 - py
    ex, ey = qx2 - qx, qy2 - qy
    denominator = dx * ey - dy * ex
    if denominator == 0:
        return None
    a = ((qx - px) * ey - (qy - py) * ex) / denominator
    b = ((qx - px) * dy - (qy - py) * dx) / denominator
    if 0 <= a <= 1 and 0 <= b <= 1:
        return (px + a * dx, py + a * dy)
    return None


def crossings(a: list[Polyline], b: list[Polyline]) -> list[Point]:
    """Return the points where two sets of polylines cross."""
    return [
        point
        for s, t in itertools.product(segments(a), segments(b))
        if (point := intersection(s, t)) is not None
    ]


def point_distance(point: Point, segment: Segment) -> float:
    """Return the distance from a point to a segment."""
    (ax, ay), (bx, by) = segment
    dx, dy = bx - ax, by - ay
    length = dx * dx + dy * dy
    t = 0 if length == 0 else ((point[0] - ax) * dx + (point[1] - ay) * dy) / length
    t = min(max(t, 0), 1)
    return math.dist(point, (ax + t * dx, ay + t * dy))


def outline_gap(point: Point, shape: Shape) -> float:
    """Return the distance from a point to the nearer edge of the nearest line of a shape."""
    return min(
        point_distance(point, side) - width / 2
        for line, width in zip(shape.lines, shape.line_widths, strict=True)
        for side in itertools.pairwise(line)
    )


def frame_under(point: Point, frames: dict[str, Shape]) -> Shape | None:
    """Return the frame whose line lies nearest a point, within the frame gap, None if none does."""
    nearest = min(frames.values(), key=lambda f: outline_gap(point, f), default=None)
    return nearest if nearest and outline_gap(point, nearest) <= FRAME_GAP else None


def near(a: list[Polyline], b: list[Polyline], limit: float) -> Point | None:
    """Return a point of one of two sets of polylines where they come closer than a limit, None if they do not."""
    if points := crossings(a, b):
        return points[0]
    distance, point = min(
        (point_distance(point, segment), point)
        for lines, others in ((a, b), (b, a))
        for line in lines
        for point in line
        for segment in segments(others)
    )
    return point if distance < limit else None


def inside(point: Point, lines: list[Polyline]) -> bool:
    """Tell whether a point lies inside one of closed polylines."""
    x, y = point
    for line in lines:
        if line[0] != line[-1]:
            continue
        crossed = False
        for (ax, ay), (bx, by) in itertools.pairwise(line):
            if (ay > y) != (by > y) and x < ax + (y - ay) * (bx - ax) / (by - ay):
                crossed = not crossed
        if crossed:
            return True
    return False


def at_rounded_corner(point: Point, box: Shape) -> bool:
    """Tell whether a point lies in the square at a corner of a rounded box where the rounding is drawn."""
    xs, ys = zip(*(p for line in box.lines for p in line))
    radius = min(CORNER_RADIUS, (max(xs) - min(xs)) / 3, (max(ys) - min(ys)) / 3)
    # Distances to the nearest vertical and horizontal sides, negative outside
    return all(
        -ATTACH_TOLERANCE - max(box.line_widths) / 2
        < min(v - min(vs), max(vs) - v)
        < radius
        for v, vs in ((point[0], xs), (point[1], ys))
    )


def center(rect: Rect) -> Point:
    """Return the center of a rectangle."""
    return (rect[0] + rect[2]) / 2, (rect[1] + rect[3]) / 2


def touches(rect: Rect, lines: list[Polyline]) -> bool:
    """Tell whether polylines enter a rectangle widened by the label margin."""
    left, bottom, right, top = (
        rect[0] - LABEL_MARGIN,
        rect[1] - LABEL_MARGIN,
        rect[2] + LABEL_MARGIN,
        rect[3] + LABEL_MARGIN,
    )
    if any(
        left <= x <= right and bottom <= y <= top for line in lines for x, y in line
    ):
        return True
    corners = [(left, bottom), (right, bottom), (right, top), (left, top)]
    return bool(crossings(lines, [corners + corners[:1]]))


def overlap(a: Rect, b: Rect) -> bool:
    """Tell whether two rectangles come closer than the label margin."""
    return (
        a[0] - LABEL_MARGIN < b[2]
        and b[0] - LABEL_MARGIN < a[2]
        and a[1] - LABEL_MARGIN < b[3]
        and b[1] - LABEL_MARGIN < a[3]
    )


def render(path: Path) -> tuple[dict[str, Any], str]:
    """Lay out a .dot file and return Graphviz's JSON description of the drawing, and its SVG."""
    output = subprocess.run(
        ["dot", "-Tjson", "-Tsvg", str(path)],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=None,
        check=True,
        text=True,
    ).stdout
    # Graphviz writes one format after the other, then the next graph's
    graph, end = json.JSONDecoder().raw_decode(output)
    svg = output[end:]
    if svg.count("</svg>") != 1:
        raise ValueError("The file holds more than one graph")
    return graph, svg


def graphviz_log(path: Path) -> str:
    """Lay out a .dot file and return Graphviz's verbose output."""
    return subprocess.run(
        ["dot", "-v", "-Tjson", str(path)],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        check=True,
        text=True,
    ).stderr


def has_neato() -> bool:
    """Tell whether Graphviz lists the neato layout engine as installed."""
    log = subprocess.run(
        ["dot", "-v", "-Tjson"],
        input="graph {}",
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        check=True,
        text=True,
    ).stderr
    if not (match := LAYOUTS.search(log)):
        raise ValueError("Graphviz lists no layout engine in its verbose output")
    return "neato" in match[1].split()


def font_defects(log: str) -> list[str]:
    """Find the fonts in Graphviz's verbose output whose text it measures with another font file than the one drawn."""
    defects = []
    for line in log.splitlines():
        if not (match := FONT_RESOLUTION.fullmatch(line)):
            continue
        name, measured = match[1] or match[3], match[2]
        drawn = subprocess.run(
            ["fc-match", "--format=%{file}", "--", name],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=None,
            check=True,
            text=True,
        ).stdout
        if measured != drawn:
            defects.append(
                f'font "{name}": measured with {measured or "an unresolved font"}, drawn with {drawn}'
            )
    return defects


def in_svg(findings: list[Finding], svg: str) -> list[Finding]:
    """Move the positions of findings from layout points to points from the top left corner of the SVG drawing them."""
    if not (match := SVG_TRANSFORM.search(svg)):
        raise ValueError("Graphviz's SVG output has no graph transform")
    scale_x, scale_y, angle, shift_x, shift_y = map(float, match.groups())
    cos, sin = math.cos(math.radians(angle)), math.sin(math.radians(angle))
    placed = []
    for message, (x, y) in findings:
        x, y = x + shift_x, shift_y - y
        placed.append(
            (message, (scale_x * (x * cos - y * sin), scale_y * (x * sin + y * cos)))
        )
    return placed


def check(graph: dict[str, Any], svg: str) -> Report:
    """Find layout defects and arrow crossings in a laid out graph, placed in its SVG."""
    objects = graph.get("objects", [])
    centers = {}
    nodes = {}
    frames = {}
    # Nodes drawing nothing at all, whose arrow ends attach to the frame line under them
    anchors = set()
    labels = []
    for i, o in enumerate(objects):
        if i >= graph["_subgraph_cnt"]:
            x, y = map(float, o["pos"].split(","))
            centers[i] = (x, y)
            draw, ldraw = visible(o.get("_draw_", [])), o.get("_ldraw_", [])
            lines = trace(draw + ldraw)
            # Nodes drawing no line, like invisible ones or bare text, have none to attach to
            if lines:
                styles = o.get("style", "").replace(",", " ").split()
                rounded_box = o.get("shape") in BOXES and "rounded" in styles
                # Each xdot attribute starts drawing at the default width
                widths = line_widths(draw) + line_widths(ldraw)
                nodes[i] = Shape(o["name"], lines, widths, rounded_box)
            if not draw and not ldraw:
                anchors.add(i)
            # Text within its node's outline is checked with the outline
            labels.extend(
                Label(f'label "{text}" of {o["name"]}', rect, None if lines else i)
                for text, rect in texts(ldraw)
                if not lines or not inside(center(rect), lines)
            )
        else:
            ops = visible(o.get("_draw_", []))
            # Frames drawing no line, like transparent ones, have none to check
            if lines := trace(ops):
                name = (
                    f'frame "{o["label"]}"' if o.get("label") else f"frame {o['name']}"
                )
                frames[o["name"]] = Shape(name, lines, line_widths(ops))
            labels.extend(
                Label(f'title "{text}"', rect)
                for text, rect in texts(o.get("_ldraw_", []))
            )
    arrow = "->" if graph["directed"] else "--"
    edges = []
    for e in sorted(graph.get("edges", []), key=lambda e: e["_gvid"]):
        name = f"{objects[e['tail']]['name']} {arrow} {objects[e['head']]['name']}"
        for key in ("_ldraw_", "_hldraw_", "_tldraw_"):
            labels.extend(
                Label(f'label "{text}" of {name}', rect)
                for text, rect in texts(e.get(key, []))
            )
        lines = trace([op for op in visible(e.get("_draw_", [])) if op["op"] in "bB"])
        if not lines:
            continue
        # The edge's splines: their arrowhead tips, s at the tail and e at the head, then their points
        splines = [[t.split(",") for t in part.split()] for part in e["pos"].split(";")]
        tips = {
            t[0]: (float(t[1]), float(t[2])) for s in splines for t in s if len(t) == 3
        }
        paths = [
            [(float(t[0]), float(t[1])) for t in s if len(t) == 2] for s in splines
        ]
        ends = {
            kind: End(
                frames.get(e.get(f"l{kind}"))
                or nodes.get(e[kind])
                or (frame_under(point, frames) if e[kind] in anchors else None),
                point,
                base,
                trace(visible(e.get(draw_key, []))),
            )
            for kind, point, base, draw_key in (
                ("tail", tips.get("s", paths[0][0]), paths[0][0], "_tdraw_"),
                ("head", tips.get("e", paths[-1][-1]), paths[-1][-1], "_hdraw_"),
            )
        }
        edges.append(
            Edge(
                name=name,
                tail=e["tail"],
                head=e["head"],
                lines=lines,
                centerline=[bezier(path) for path in paths],
                ends=ends,
            )
        )

    defects: list[Finding] = []
    for edge in edges:
        for kind, end in edge.ends.items():
            if not (outline := end.outline):
                continue
            sides = segments(outline.lines)
            if (off := outline_gap(end.point, outline)) > ATTACH_TOLERANCE:
                corner = outline.rounded_box and at_rounded_corner(end.point, outline)
                defects.append(
                    (
                        f"{edge.name}: {kind} {off:.1f}pt off the outline of {outline.name}"
                        + ", at a rounded corner" * corner,
                        end.point,
                    )
                )
            elif end.arrowhead and end.point != end.base:
                # How much farther the base lies from the outline than the tip, over the arrowhead's
                # length, is the sine of the angle against a straight side, and follows the outline
                # past the tip
                base_clearance = min(point_distance(end.base, s) for s in sides)
                tip_clearance = min(point_distance(end.point, s) for s in sides)
                rise = base_clearance - tip_clearance
                length = math.dist(end.base, end.point)
                meeting_angle = math.degrees(math.asin(min(1, rise / length)))
                if meeting_angle < MIN_ARROWHEAD_ANGLE:
                    defects.append(
                        (
                            f"{edge.name}: {kind} meets the outline of {outline.name} at {meeting_angle:.1f}°",
                            end.point,
                        )
                    )
        for i, node in nodes.items():
            if i not in (edge.tail, edge.head) and (
                points := crossings(edge.drawn(), node.lines)
            ):
                defects.append((f"{edge.name}: passes through {node.name}", points[0]))
        ends = [end.point for end in edge.ends.values()]
        for frame in frames.values():
            # Points where the arrow crosses the outline away from its ends, once each
            points: list[Point] = []
            for point in crossings(edge.centerline, frame.lines):
                if min(math.dist(point, p) for p in ends + points) > END_TOLERANCE:
                    points.append(point)
            on_line = [end.outline is frame for end in edge.ends.values()]
            inside_ends = sum(
                inside(centers[i], frame.lines)
                for i, on in zip((edge.tail, edge.head), on_line, strict=True)
                if not on
            )
            # An arrow with one end inside and none on the outline crosses it once, others never
            if len(points) > int(inside_ends == 1 and not any(on_line)):
                way = "leaves and re-enters" if inside_ends else "passes through"
                defects.append((f"{edge.name}: {way} {frame.name}", points[0]))
    for node in nodes.values():
        for frame in frames.values():
            if (point := near(node.lines, frame.lines, FRAME_GAP)) is not None:
                defects.append((f"{node.name}: touches {frame.name}", point))
    ends_with_arrowheads = [
        (edge, kind, end)
        for edge in edges
        for kind, end in edge.ends.items()
        if end.arrowhead
    ]
    for edge, kind, end in ends_with_arrowheads:
        for frame in frames.values():
            # An arrow attached to a frame ends on its line
            if frame is end.outline:
                continue
            if (point := near(end.arrowhead, frame.lines, FRAME_GAP)) is not None:
                defects.append((f"{edge.name}: {kind} touches {frame.name}", point))
    pairs = itertools.combinations(ends_with_arrowheads, 2)
    for (a, a_kind, a_end), (b, b_kind, b_end) in pairs:
        if (point := near(a_end.arrowhead, b_end.arrowhead, ARROWHEAD_GAP)) is not None:
            defects.append(
                (f"{a.name}: {a_kind} overlaps the {b_kind} of {b.name}", point)
            )
    for i, label in enumerate(labels):
        position = center(label.rect)
        for edge in edges:
            if label.node not in (edge.tail, edge.head) and touches(
                label.rect, edge.drawn()
            ):
                defects.append((f"{label.name}: touches {edge.name}", position))
        for node in nodes.values():
            if touches(label.rect, node.lines) or inside(position, node.lines):
                defects.append((f"{label.name}: touches {node.name}", position))
        for other in labels[i + 1 :]:
            if overlap(label.rect, other.rect):
                defects.append((f"{label.name}: touches {other.name}", position))
        for frame in frames.values():
            if touches(label.rect, frame.lines):
                defects.append((f"{label.name}: touches {frame.name}", position))

    crossed: list[Finding] = []
    for a, b in itertools.combinations(edges, 2):
        ends = [end.point for edge in (a, b) for end in edge.ends.values()]
        if points := [
            point
            for point in crossings(a.lines, b.lines)
            if min(math.dist(point, end) for end in ends) > END_TOLERANCE
        ]:
            crossed.append((f"{a.name} crosses {b.name}", points[0]))

    if not (match := SVG_SIZE.search(svg)):
        raise ValueError("Graphviz's SVG output has no size")
    width, height = map(float, match.groups())
    return Report(in_svg(defects, svg), in_svg(crossed, svg), (width, height))


def main() -> None:
    """Check the .dot file given on the command line, print the problems and size, and fail on defects."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("file", type=Path, help="Graphviz .dot file")
    args = parser.parse_args()
    if not has_neato():
        print(
            "Warning: the neato layout is missing, Debian and Ubuntu ship it in the libgvplugin-neato-layout8 package"
        )
    report = check(*render(args.file))
    fonts = font_defects(graphviz_log(args.file))
    for defect in fonts:
        print(f"Defect: {defect}")
    for defect, (x, y) in report.defects:
        print(f"Defect at ({x:.0f}, {y:.0f}): {defect}")
    for crossing, (x, y) in report.crossings:
        print(f"Crossing at ({x:.0f}, {y:.0f}): {crossing}")
    defect_count = len(fonts) + len(report.defects)
    crossing_count = len(report.crossings)
    print(
        f"Size: {report.size[0]:g} × {report.size[1]:g}pt, "
        f"{defect_count} defect{'s' * (defect_count != 1)}, "
        f"{crossing_count} crossing{'s' * (crossing_count != 1)}"
    )
    if defect_count:
        sys.exit(1)


if __name__ == "__main__":
    main()
