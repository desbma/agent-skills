digraph review_workflow {
    layout=neato
    inputscale=72
    splines=line
    pad=0.2
    fontname="DejaVu Sans,sans-serif"
    node [shape=box, style="rounded,filled", fontname="DejaVu Sans,sans-serif"]
    edge [fontname="DejaVu Sans,sans-serif", fontsize=10]

    // Main agent, waves sized and spaced like the judges, mirroring their arrows
    node [fillcolor="#cfe2f3"]
    wave_a [label="Wave A", pos="-15,266!", width=1.46, height=0.8]
    wave_b [label="Wave B", pos="-15,77!", width=1.46, height=0.8]
    apply_a [label="main agent\napplies fixes", pos="888,266!"]
    apply_b [label="main agent\napplies fixes", pos="888,77!"]

    // Reviewers, in run columns, two rows per wave
    node [fillcolor="#fff2cc"]
    correctness [label="review-correctness\nrun 1", pos="180,296!"]
    readability [label="review-readability\nrun 1", pos="180,236!"]
    tests [label="review-tests\nrun 1", pos="180,107!"]
    docs [label="review-docs\nrun 1", pos="180,47!"]
    node [style="rounded,filled,dotted"]
    correctness_n [label="review-correctness\nrun 2 … N", pos="365,296!"]
    readability_n [label="review-readability\nrun 2 … N", pos="365,236!"]
    tests_n [label="review-tests\nrun 2 … N", pos="365,107!"]
    docs_n [label="review-docs\nrun 2 … N", pos="365,47!"]

    // Judge, tall enough for its two arrows to arrive on its left side
    node [style="rounded,filled", fillcolor="#d9ead3", height=0.8]
    judge_a [label="review-judge", pos="560,266!"]
    judge_b [label="review-judge", pos="560,77!"]

    // User
    node [shape=ellipse, style=filled, fillcolor=lightgrey, height=0.5]
    user_a [label="user decides", pos="725,266!"]
    user_b [label="user decides", pos="725,77!"]

    // Bracket spanning the run columns of the first wave's reviewers, and its note
    node [shape=plain, style=""]
    bracket_a [pos="272,202!", label=<<table border="0" cellborder="1" cellspacing="0"><tr><td sides="LBR" width="331" height="8"></td></tr></table>>]
    note [pos="272,188!", fontsize=10, label="number of runs auto scales with reviewed diff size"]

    // Corners of the repeat and hand-off lines
    node [shape=point, style=invis, width=0]
    repeat_a1 [pos="888,340!"]; repeat_a2 [pos="-15,340!"]
    repeat_b1 [pos="888,1!"]; repeat_b2 [pos="-15,1!"]
    // Dots as wide as the hand-off line, joining its segments
    node [style="", width=0.028, penwidth=0, fillcolor=black]
    handoff_1 [pos="888,164!"]; handoff_2 [pos="-15,164!"]

    // Wave A
    wave_a -> correctness [headport=w]
    wave_a -> readability [headport=w]
    correctness -> correctness_n [style=dotted]
    readability -> readability_n [style=dotted]
    correctness_n -> judge_a [tailport=e]
    readability_n -> judge_a [tailport=e]
    judge_a -> user_a
    user_a -> apply_a
    // Repeat, around the top of the wave
    edge [style=dashed, dir=none]
    apply_a -> repeat_a1 [tailport=n]
    repeat_a1 -> repeat_a2 [label="repeat"]
    repeat_a2 -> wave_a [headport=n, dir=forward]

    // Hand-off to wave B, between the rows
    edge [style="", penwidth=2]
    apply_a -> handoff_1 [tailport=s]
    handoff_1 -> handoff_2
    handoff_2 -> wave_b [headport=n, dir=forward]

    // Wave B
    edge [penwidth=1, dir=forward]
    wave_b -> tests [headport=w]
    wave_b -> docs [headport=w]
    tests -> tests_n [style=dotted]
    docs -> docs_n [style=dotted]
    tests_n -> judge_b [tailport=e]
    docs_n -> judge_b [tailport=e]
    judge_b -> user_b
    user_b -> apply_b
    // Repeat, around the bottom of the wave
    edge [style=dashed, dir=none]
    apply_b -> repeat_b1 [tailport=s]
    repeat_b1 -> repeat_b2 [label="repeat"]
    repeat_b2 -> wave_b [headport=s, dir=forward]
}
